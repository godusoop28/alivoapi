# Postgres (local dev example — usa tus propias credenciales)
DATABASE_URL=jdbc:postgresql://localhost:5432/alivos
DB_USERNAME=alivos
DB_PASSWORD=change_me

# Puerto (Render inyecta PORT automáticamente; local usa 8080 por defecto)
PORT=8080

# JWT
JWT_SECRET=change_me_super_secret
JWT_EXPIRATION_MS=604800000

# CORS (lista separada por comas). localhost:3000 y el dominio de Vercel
# ya están permitidos por defecto aunque no los incluyas.
CORS_ORIGIN=http://localhost:3000,https://alivoweb-uuoo.vercel.app

# Vimeo (opcional). Sin token, la resolución de video usa oEmbed público
# y cae en una miniatura de reemplazo si el video no es accesible.
VIMEO_ACCESS_TOKEN=

# Cloudinary (subida de imágenes y PDFs desde el panel de admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago (integración real pendiente — solo placeholder por ahora)
MERCADO_PAGO_ACCESS_TOKEN=

# Sembrar datos demo al iniciar (idempotente). Poner en false para
# desactivar el seed en un ambiente ya poblado.
SEED_ON_STARTUP=true
